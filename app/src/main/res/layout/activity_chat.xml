<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Roadside Assist Bot 🚗"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp"
        android:background="#FFA500"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintBottom_toTopOf="@id/quickActionScroll">

        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

    <HorizontalScrollView
        android:id="@+id/quickActionScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="8dp"
        android:background="#E0E0E0"
        app:layout_constraintBottom_toTopOf="@id/inputArea">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFlatTire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flat Tire"
                android:layout_marginEnd="8dp"
                android:textColor="#333333"
                android:backgroundTint="#FFFFFF"
                style="?android:attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/btnOverheat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Engine Overheating"
                android:layout_marginEnd="8dp"
                android:textColor="#333333"
                android:backgroundTint="#FFFFFF"
                style="?android:attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dead Battery"
                android:layout_marginEnd="8dp"
                android:textColor="#333333"
                android:backgroundTint="#FFFFFF"
                style="?android:attr/buttonBarButtonStyle" />

            <Button
                android:id="@+id/btnNoise"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Strange Noise"
                android:textColor="#333333"
                android:backgroundTint="#FFFFFF"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/inputArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="e.g., I have a flat tyre"
            android:background="@android:drawable/editbox_background"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Send"
            android:backgroundTint="#FFA500"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>